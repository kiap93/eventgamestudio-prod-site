# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The frontend web application origin (e.g. https://eventgamestudio.com) used for post-OAuth browser redirects.
APP_URL="https://eventgamestudio.com"

# ====================================================
# SUPABASE CONFIGURATION
# ====================================================
# SUPABASE_URL: Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Supabase Service Role Secret Key
# SERVER-SIDE ONLY - NEVER prefix with VITE_ and NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=""

# VITE_SUPABASE_URL: Supabase Project URL for frontend browser SDK
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Supabase Anonymous / Public Key for frontend browser SDK
VITE_SUPABASE_ANON_KEY=""

# JWT_SECRET: Strong random 256-bit secret key used to sign application JWT access tokens server-side.
# SERVER-SIDE ONLY - NEVER prefix with VITE_, NEVER expose to browser/git, and REQUIRED in production.
JWT_SECRET=""

# ALLOWED_ORIGINS: Comma-separated list of permitted CORS frontend web origins (e.g. https://eventgamestudio.com,https://www.eventgamestudio.com,https://app.eventgamestudio.com).
ALLOWED_ORIGINS="https://eventgamestudio.com,https://www.eventgamestudio.com,https://app.eventgamestudio.com"

# DEVELOPER_EMAILS: Comma-separated list of verified admin email addresses allowed to access platform developer tools in production.
DEVELOPER_EMAILS=""

# ALLOW_MOCK_AUTH: Only for local dev tests ('true' / 'false'). Strictly forbidden & rejected in production.
ALLOW_MOCK_AUTH="false"

# EXPOSE_API_ERRORS: Optional temporary production debugging flag ('true' / 'false').
# When 'true', API returns actual underlying error messages instead of generic "Something went wrong. Please try again.".
# Defaults to "false" (safe mode). NEVER leave enabled permanently in production.
EXPOSE_API_ERRORS="false"

# VITE_EVENT_REFERENCE_DATE: Optional development/testing reference date (YYYY-MM-DD, e.g. "2026-05-10").
# When set (or when window.__EVENT_REFERENCE_DATE__ or ?refDate= is provided), simulates that calendar date as today.
# Leave empty in production to use the real system clock.
VITE_EVENT_REFERENCE_DATE=""

# VITE_GOOGLE_CLIENT_ID: Your Google Cloud Console OAuth Web Client ID for Google Identity Services.
# Safe for frontend exposure as it identifies the Google OAuth client.
VITE_GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

# VITE_API_BASE_URL: Dedicated Cloudflare Worker API URL for frontend requests.
VITE_API_BASE_URL=https://YOUR-NEW-API-URL

# ====================================================
# GOOGLE GMAIL API INTEGRATION (SERVER-SIDE ONLY)
# ====================================================
# GOOGLE_MAIL_CLIENT_ID: Google Cloud OAuth 2.0 Client ID for Gmail sending.
# SERVER-SIDE ONLY - NEVER prefix with VITE_
GOOGLE_MAIL_CLIENT_ID=""

# GOOGLE_MAIL_CLIENT_SECRET: Google Cloud OAuth 2.0 Client Secret for Gmail sending.
# SERVER-SIDE ONLY - NEVER prefix with VITE_ and NEVER expose to browser
GOOGLE_MAIL_CLIENT_SECRET=""

# GOOGLE_MAIL_REDIRECT_URI: OAuth 2.0 Authorized redirect URI on the API worker (e.g. https://YOUR-NEW-API-URL/api/email/google/callback).
GOOGLE_MAIL_REDIRECT_URI="https://YOUR-NEW-API-URL/api/email/google/callback"

# GOOGLE_MAIL_TOKEN_ENCRYPTION_KEY: 256-bit AES encryption key used to encrypt Google refresh tokens at rest.
# SERVER-SIDE ONLY - NEVER prefix with VITE_ and NEVER expose to browser
GOOGLE_MAIL_TOKEN_ENCRYPTION_KEY=""

# ====================================================
# PAYMENT GATEWAY & WEBHOOKS (SERVER-SIDE ONLY)
# ====================================================
# PAYMENT_WEBHOOK_SECRET: MANDATORY for payment processing. Secret key (e.g. Stripe whsec_... or gateway HMAC key) for verifying webhook signatures.
# Without this, incoming webhooks are rejected with 500 error and wallet top-up balances are not credited.
# SERVER-SIDE ONLY - NEVER prefix with VITE_ and NEVER expose to browser
PAYMENT_WEBHOOK_SECRET=""

# STRIPE_SECRET_KEY: Stripe API Secret Key for live checkout sessions
# SERVER-SIDE ONLY - NEVER prefix with VITE_ and NEVER expose to browser
STRIPE_SECRET_KEY=""

# ====================================================
# RESEND EMAIL SERVICE (ADMIN CUSTOMER INVITATIONS)
# ====================================================
# RESEND_API_KEY: Dedicated Resend API Secret Key for admin invitations.
# SERVER-SIDE ONLY - NEVER prefix with VITE_ and NEVER expose to browser
RESEND_API_KEY=""

# RESEND_INVITATION_FROM: Configured sender address for admin invitations (e.g. "Mun Jian (EventGameStudio) <invitations@eventgamestudio.com>" or "onboarding@resend.dev").
# SERVER-SIDE ONLY - NEVER prefix with VITE_ and NEVER expose to browser
RESEND_INVITATION_FROM=""
