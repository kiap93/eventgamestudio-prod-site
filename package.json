{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:flow": "tsx server/db/event_payment_flow.test.ts",
    "test:cors": "tsx server/cors.test.ts",
    "test:wallet": "tsx server/db/wallet_security_lifecycle.test.ts && tsx server/db/wallet_topup.test.ts && tsx server/db/wallet_credits.test.ts && tsx server/db/showcase_reward.test.ts && tsx server/db/wallet_production_acid.test.ts && tsx server/db/atomic_payment_acid.test.ts",
    "test:security": "tsx server/db/wallet_security_lifecycle.test.ts",
    "test:credits": "tsx server/db/wallet_credits.test.ts",
    "test:showcase": "tsx server/db/showcase_reward.test.ts",
    "test:upload-security": "tsx server/db/showcase_direct_upload_security.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "phaser": "^4.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.0.0"
  }
}
